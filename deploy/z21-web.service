# systemd-Dienst für Z21 Web auf einem Raspberry Pi (oder jedem anderen Linux).
#   sudo cp deploy/z21-web.service /etc/systemd/system/
#   sudo install -m 600 /dev/null /etc/z21-web.env   # dann Z21_PASSWORD=… hineinschreiben
#   sudo systemctl daemon-reload && sudo systemctl enable --now z21-web
[Unit]
Description=Z21 Web (Modellbahnsteuerung)
After=network-online.target
Wants=network-online.target

[Service]
User=z21
WorkingDirectory=/opt/z21-web
ExecStart=/usr/bin/npm start
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3001
Environment=DATA_DIR=/var/lib/z21-web
# Z21_PASSWORD (Pflicht bei HOST=0.0.0.0), optional TLS_CERT/TLS_KEY, TRUST_PROXY, Z21_REQUIRE_HTTPS
EnvironmentFile=/etc/z21-web.env
Restart=on-failure
RestartSec=3
# Der Pi 3 hat 1 GB RAM: Node nicht mehr als nötig nehmen lassen
Environment=NODE_OPTIONS=--max-old-space-size=256
StateDirectory=z21-web
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
