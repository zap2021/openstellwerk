{
  "name": "z21-web",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n sim,server,web -c gray,blue,green \"npm run dev -w @z21/simulator\" \"npm run dev -w @z21/server\" \"npm run dev -w @z21/web\"",
    "dev:server": "npm run dev -w @z21/server",
    "dev:sim": "npm run dev -w @z21/simulator",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run build -w @z21/web",
    "start": "npm run start -w @z21/server"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
